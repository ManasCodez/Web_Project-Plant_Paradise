{
  "name": "plant-paradise",
  "version": "1.0.0",
  "description": "Plant Paradise - Full Stack Node.js, Express & MongoDB application",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed:content": "node scripts/seed-content.js",
    "test:content": "node --test tests/content.test.js",
    "migrate:admin": "node scripts/migrate-admin.js",
    "admin:promote": "node scripts/promote-admin.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --test tests/integration.test.js",
    "test:commerce": "node --test tests/commerce-smoke.test.js"
  },
  "keywords": [
    "plants",
    "express",
    "mongodb",
    "nodejs",
    "ecommerce"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "jsdom": "^31.0.1",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14"
  },
  "engines": {
    "node": ">=22"
  }
}
